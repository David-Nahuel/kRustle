{
  "version": 3,
  "routes": [
    {
      "src": "/(main|chunk|polyfills|styles)-[A-Za-z0-9_-]{8}\\.(js|css)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
